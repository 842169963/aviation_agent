@prefix av: <https://example.org/aviation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

av:proc_0_tree_landing a av:EmergencyProcedure ;
    av:aircraft_phase "landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Aim for low, closely spaced trees with wide, dense crowns"^^xsd:string ;
            av:expected_result "Safer landing environment"^^xsd:string ;
            av:source_excerpt "Low, closely spaced trees with wide, dense crowns (branches) close to the ground are much better than tall trees with thin tops."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Head into the wind to keep groundspeed low"^^xsd:string ;
            av:expected_result "Reduced groundspeed upon landing"^^xsd:string ;
            av:source_excerpt "Keep the groundspeed low by heading into the wind."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Involve the underside of the fuselage and both wings in the initial tree contact"^^xsd:string ;
            av:expected_result "More even and positive cushioning effect"^^xsd:string ;
            av:source_excerpt "Involving the underside of the fuselage and both wings in the initial tree contact provides a more even and positive cushioning effect."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Avoid direct contact of the fuselage with heavy tree trunks"^^xsd:string ;
            av:expected_result "Minimized risk of damage to the fuselage"^^xsd:string ;
            av:source_excerpt "Avoid direct contact of the fuselage with heavy tree trunks."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Make contact at minimum indicated airspeed, but not below stall speed"^^xsd:string ;
            av:expected_result "Controlled landing attitude in tree branches"^^xsd:string ;
            av:source_excerpt "Make contact at minimum indicated airspeed, but not below stall speed, and 'hang' the airplane in the tree branches in a nose-high landing attitude."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Direct the airplane between two properly spaced trees if heavy trunk contact is unavoidable"^^xsd:string ;
            av:expected_result "Simultaneous wing contact to minimize damage"^^xsd:string ;
            av:source_excerpt "If heavy tree trunk contact is unavoidable once the airplane is on the ground, it is best to involve both wings simultaneously by directing the airplane between two properly spaced trees."^^xsd:string ;
            av:step_number 8 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Ensure initial tree contact is symmetrical"^^xsd:string ;
            av:expected_result "Maintained proper airplane attitude"^^xsd:string ;
            av:source_excerpt "Ideally, initial tree contact should be symmetrical; that is, both wings should meet equal resistance in the tree branches."^^xsd:string ;
            av:step_number 7 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Use the normal landing configuration (full flaps, gear down)"^^xsd:string ;
            av:expected_result "Aircraft is configured for landing"^^xsd:string ;
            av:source_excerpt "Use the normal landing configuration (full flaps, gear down)."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Tree Landing"^^xsd:string ;
    av:source_excerpt "Although a tree landing is not an attractive prospect, the following general guidelines help to make the experience survivable."^^xsd:string ;
    av:source_file "10_trees_forest.txt"^^xsd:string ;
    av:source_section "Trees (Forest)"^^xsd:string ;
    av:trigger_condition "Emergency landing in a forested area"^^xsd:string .

av:proc_10_landing_gear_malfunc a av:EmergencyProcedure ;
    av:aircraft_phase "landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Land with one main gear retracted if necessary"^^xsd:string ;
            av:expected_result "Minimizes damage during landing"^^xsd:string ;
            av:source_excerpt "If the pilot elects to land with one main gear retracted (and the other main gear and nose gear down and locked), the landing should be made in a nose-high attitude with the wings level."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Select an airport with crash and rescue facilities"^^xsd:string ;
            av:expected_result "Emergency equipment is standing by"^^xsd:string ;
            av:source_excerpt "The pilot should select an airport with crash and rescue facilities, if possible."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Use full opposite rudder and aggressive braking after touchdown"^^xsd:string ;
            av:expected_result "Maintain directional control"^^xsd:string ;
            av:source_excerpt "The pilot should be prepared to use full opposite rudder and aggressive braking to maintain some degree of directional control."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Consider burning off excess fuel"^^xsd:string ;
            av:expected_result "Reduces landing speed and fire potential"^^xsd:string ;
            av:source_excerpt "The pilot should consider burning off excess fuel. This reduces landing speed and fire potential."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "A hard surface runway creates sparks that can ignite fuel."^^xsd:string ],
        [ a av:Warning ;
            av:description "Applying and holding full up-elevator results in the nose abruptly dropping to the surface as airspeed decays, possibly resulting in burrowing and/or additional damage."^^xsd:string ] ;
    av:name "Landing Gear Malfunction"^^xsd:string ;
    av:source_excerpt "Once the pilot has confirmed that the landing gear has in fact malfunctioned and that one or more gear legs refuses to respond to the conventional or alternate methods of gear extension contained in the AFM/POH, a gear-up landing is considered inevitable."^^xsd:string ;
    av:source_file "20_landing_gear_malfunction.txt"^^xsd:string ;
    av:source_section "Landing Gear Malfunction"^^xsd:string ;
    av:trigger_condition "Landing gear has malfunctioned and refuses to respond to extension methods"^^xsd:string .

av:proc_11_electrical_system_fa a av:EmergencyProcedure ;
    av:aircraft_phase "in-flight"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Plan for a no-flap landing and anticipate manual landing gear extension"^^xsd:string ;
            av:expected_result "Prepare for landing without electrical assistance"^^xsd:string ;
            av:source_excerpt "If landing gear or flaps are electrically controlled or operated, plan the arrival well ahead of time."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Notify ATC of the situation immediately"^^xsd:string ;
            av:expected_result "Request radar vectors for a landing at the nearest suitable airport"^^xsd:string ;
            av:source_excerpt "Understand that any loss of electrical power is critical in a small airplane—notify ATC of the situation immediately."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Shed all but the most necessary electrically-driven equipment"^^xsd:string ;
            av:expected_result "Preserve battery power for critical systems"^^xsd:string ;
            av:source_excerpt "The pilot should immediately shed non-essential loads when the generating source fails."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "The electrically-powered landing gear and flaps do not function properly on the power left in a partially-depleted battery."^^xsd:string ] ;
    av:name "Electrical System Failure"^^xsd:string ;
    av:source_excerpt "If the pilot expects an imminent and complete in-flight loss of electrical power, the following steps should be taken:"^^xsd:string ;
    av:source_file "20_landing_gear_malfunction.txt"^^xsd:string ;
    av:source_section "System Malfunctions"^^xsd:string ;
    av:trigger_condition "Loss of electrical power"^^xsd:string .

av:proc_12_inadvertent_door_ope a av:EmergencyProcedure ;
    av:aircraft_phase "flight, takeoff"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Concentrate on flying the airplane"^^xsd:string ;
            av:expected_result "Maintain control of the airplane despite the open door"^^xsd:string ;
            av:source_excerpt "Concentrate on flying the airplane."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Fly a normal traffic pattern and make a normal landing"^^xsd:string ;
            av:expected_result "Land safely without rushing"^^xsd:string ;
            av:source_excerpt "Fly a normal traffic pattern, and make a normal landing."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Land as soon as practicable and close the door once safely on the ground"^^xsd:string ;
            av:expected_result "Ensure the door is closed after landing"^^xsd:string ;
            av:source_excerpt "Land as soon as practicable, and close the door once safely on the ground."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Complete all items on the landing checklist"^^xsd:string ;
            av:expected_result "Ensure all safety protocols are followed during landing"^^xsd:string ;
            av:source_excerpt "Complete all items on the landing checklist."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Climb to normal traffic pattern altitude"^^xsd:string ;
            av:expected_result "Establish a safe altitude before landing"^^xsd:string ;
            av:source_excerpt "If the door opens after lift-off, do not rush to land. Climb to normal traffic pattern altitude."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Leave the door alone and do not release the seat belt"^^xsd:string ;
            av:expected_result "Avoid distraction and maintain control"^^xsd:string ;
            av:source_excerpt "Do not release the seat belt and shoulder harness in an attempt to reach the door."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Do not panic. Trying to get the airplane on the ground as quickly as possible may result in steep turns at low altitude."^^xsd:string ],
        [ a av:Warning ;
            av:description "Remember that accidents are almost never caused by an open door. Rather, an open door accident is caused by the pilot’s distraction or failure to maintain control of the airplane."^^xsd:string ] ;
    av:name "Inadvertent Door Opening In-Flight"^^xsd:string ;
    av:source_excerpt "In the event of an inadvertent door opening in flight or on takeoff, the pilot should adhere to the following:"^^xsd:string ;
    av:source_file "23_door_opening_in_flight.txt"^^xsd:string ;
    av:source_section "Door Opening In-Flight"^^xsd:string ;
    av:trigger_condition "Inadvertent door opening during flight or takeoff"^^xsd:string .

av:proc_13_emergency_autoland a av:EmergencyProcedure ;
    av:aircraft_phase "descent and landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Set transponder to squawk 7700"^^xsd:string ;
            av:expected_result "Indicates an emergency situation to ATC"^^xsd:string ;
            av:source_excerpt "EAL sets the transponder to squawk 7700 to indicate an emergency."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Broadcast position and intention to land"^^xsd:string ;
            av:expected_result "Provides information to ATC and other aircraft"^^xsd:string ;
            av:source_excerpt "It announces its call sign, 'pilot incapacitation,' its position relative to the destination airport."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Initiate emergency descent"^^xsd:string ;
            av:expected_result "Aircraft stabilizes and descends safely"^^xsd:string ;
            av:source_excerpt "Without further input, the EAL initiates an emergency descent."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Activate EAL system manually if needed"^^xsd:string ;
            av:expected_result "EAL system begins automated landing process"^^xsd:string ;
            av:source_excerpt "The system also allows for manual activation by a pilot or a passenger."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Transmit automated radio broadcasts"^^xsd:string ;
            av:expected_result "Controllers are alerted of the aircraft's imminent arrival"^^xsd:string ;
            av:source_excerpt "Once activated, the EAL system transmits automated radio broadcasts on the aircraft’s last selected frequency and on Guard (121.5 MHz)."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Emergency Autoland"^^xsd:string ;
    av:source_excerpt "If the EAL senses erratic flying, it stabilizes the aircraft, and checks for pilot responsiveness."^^xsd:string ;
    av:source_file "34_autoland.txt"^^xsd:string ;
    av:source_section "Autoland"^^xsd:string ;
    av:trigger_condition "EAL senses erratic flying or pilot incapacitation"^^xsd:string .

av:proc_14_water_ditching a av:EmergencyProcedure ;
    av:aircraft_phase "landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Keep retractable gear up unless advised otherwise by the AFM/POH."^^xsd:string ;
            av:expected_result "Proper landing configuration is maintained."^^xsd:string ;
            av:source_excerpt "Keep a retractable gear up unless the AFM/POH advises otherwise."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Use no more than intermediate flaps on low-wing airplanes."^^xsd:string ;
            av:expected_result "Prevention of asymmetrical flap failure and slowing of the airplane."^^xsd:string ;
            av:source_excerpt "Use no more than intermediate flaps on low-wing airplanes."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Drag the airplane in when possible to avoid loss of depth perception."^^xsd:string ;
            av:expected_result "Reduced risk of flying into the water or stalling."^^xsd:string ;
            av:source_excerpt "To avoid this hazard, the airplane should be 'dragged in' when possible."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Keep wings and fuel tanks intact to provide floatation."^^xsd:string ;
            av:expected_result "The airplane remains afloat for several minutes."^^xsd:string ;
            av:source_excerpt "Intact wings and fuel tanks (especially when empty) provide floatation for at least several minutes."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Execute a water landing at minimum speed and in a normal landing attitude."^^xsd:string ;
            av:expected_result "The airplane does not immediately sink upon touchdown."^^xsd:string ;
            av:source_excerpt "Also, an airplane that is ditched at minimum speed and in a normal landing attitude does not immediately sink upon touchdown."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Water Ditching"^^xsd:string ;
    av:source_excerpt "A well-executed water landing normally involves less deceleration violence than a poor tree landing or a touchdown on extremely rough terrain."^^xsd:string ;
    av:source_file "11_water_ditching_and_snow.txt"^^xsd:string ;
    av:source_section "Water (Ditching) and Snow"^^xsd:string ;
    av:trigger_condition "Water landing"^^xsd:string .

av:proc_15_snow_landing a av:EmergencyProcedure ;
    av:aircraft_phase "landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Execute a snow landing like a ditching."^^xsd:string ;
            av:expected_result "The landing is performed safely and effectively."^^xsd:string ;
            av:source_excerpt "A landing in snow should be executed like a ditching."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Be aware of loss of depth perception (white out) in reduced visibility."^^xsd:string ;
            av:expected_result "Increased situational awareness during landing."^^xsd:string ;
            av:source_excerpt "with the same regard for loss of depth perception (white out) in reduced visibility."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Maintain the same configuration as for water landing."^^xsd:string ;
            av:expected_result "Consistency in landing technique is achieved."^^xsd:string ;
            av:source_excerpt "in the same configuration."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Snow Landing"^^xsd:string ;
    av:source_excerpt "A landing in snow should be executed like a ditching, in the same configuration and with the same regard for loss of depth perception."^^xsd:string ;
    av:source_file "11_water_ditching_and_snow.txt"^^xsd:string ;
    av:source_section "Water (Ditching) and Snow"^^xsd:string ;
    av:trigger_condition "Snow landing"^^xsd:string .

av:proc_16_inadvertent_vfr_flig a av:EmergencyProcedure ;
    av:aircraft_phase "any"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Recognize and accept the seriousness of the situation and the need for immediate remedial action"^^xsd:string ;
            av:expected_result "Pilot acknowledges the emergency and prepares to take control measures."^^xsd:string ;
            av:source_excerpt "Recognition and acceptance of the seriousness of the situation and the need for immediate remedial action."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Keep the wings level"^^xsd:string ;
            av:expected_result "Prevents uncontrolled turns and maintains stability."^^xsd:string ;
            av:source_excerpt "The most important concern—in fact the only concern at this point—is to keep the wings level."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Avoid combined maneuvers such as climbing or descending turns"^^xsd:string ;
            av:expected_result "Reduces the risk of control loss."^^xsd:string ;
            av:source_excerpt "Combined maneuvers, such as climbing or descending turns, should be avoided if at all possible by an untrained instrument pilot."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Transition to visual flight when conditions allow"^^xsd:string ;
            av:expected_result "Pilot safely lands the aircraft."^^xsd:string ;
            av:source_excerpt "The pilot should take this into account and, if possible, allow time to become acclimatized and geographically oriented before attempting an approach and landing."^^xsd:string ;
            av:step_number 8 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Request ATC assistance if necessary"^^xsd:string ;
            av:expected_result "Ensures safe landing and guidance."^^xsd:string ;
            av:source_excerpt "It's reasonable to ask the controller to slow down, if this becomes an issue."^^xsd:string ;
            av:step_number 7 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Make all attitude changes smooth and small"^^xsd:string ;
            av:expected_result "Minimizes the risk of over-controlling the airplane."^^xsd:string ;
            av:source_excerpt "Make all attitude changes smooth and small, yet with positive pressure."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Maintain control of the airplane using flight instruments"^^xsd:string ;
            av:expected_result "Pilot keeps the airplane under control without relying on visual references."^^xsd:string ;
            av:source_excerpt "The only way to control the airplane safely is by using and trusting the flight instruments."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Trim the airplane to maintain hands-off level flight"^^xsd:string ;
            av:expected_result "Reduces pilot workload and helps maintain control."^^xsd:string ;
            av:source_excerpt "Trim the airplane with the elevator trim so that it maintains hands-off level flight at cruise airspeed."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Attempts to control the airplane partially by reference to flight instruments while searching outside of the airplane for visual confirmation can result in inadequate airplane control."^^xsd:string ],
        [ a av:Warning ;
            av:description "False sensations can lead to spatial disorientation, making it difficult to control the airplane."^^xsd:string ],
        [ a av:Warning ;
            av:description "The pilot should not panic; the task at hand may seem overwhelming, and the situation may be compounded by extreme apprehension."^^xsd:string ] ;
    av:name "Inadvertent VFR Flight Into IMC"^^xsd:string ;
    av:source_excerpt "The first steps necessary for surviving an encounter with IMC by a VFR pilot are as follows: Recognition and acceptance of the seriousness of the situation and the need for immediate remedial action; Maintaining control of the airplane; Obtaining the appropriate assistance to get the airplane safely on the ground."^^xsd:string ;
    av:source_file "24_inadvertent_vfr_flight_into_imc.txt | 25_maintaining_airplane_control.txt | 26_attitude_control.txt | 27_turns.txt | 28_climbs.txt | 29_descents.txt | 30_combined_maneuvers.txt | 31_transition_to_visual_flight.txt"^^xsd:string ;
    av:source_section "Inadvertent VFR Flight Into IMC"^^xsd:string ;
    av:trigger_condition "Encountering instrument meteorological conditions (IMC) unexpectedly"^^xsd:string .

av:proc_17_ballistic_parachute_ a av:EmergencyProcedure ;
    av:aircraft_phase "in-flight"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Ensure passengers know the basic sequence of steps for deployment."^^xsd:string ;
            av:expected_result "Passengers are prepared to deploy the parachute if necessary."^^xsd:string ;
            av:source_excerpt "At a minimum, the pilot should also brief the passengers regarding the basic sequence of steps for deployment."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Brief passengers on the conditions for safe deployment of the parachute system."^^xsd:string ;
            av:expected_result "Passengers understand when and how to deploy the parachute system."^^xsd:string ;
            av:source_excerpt "Pilots should brief passengers with access to any deployment mechanism regarding the conditions for a safe deployment."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Follow the guidance provided by manufacturers and suppliers for parachute deployment."^^xsd:string ;
            av:expected_result "Deployment is conducted according to established safety protocols."^^xsd:string ;
            av:source_excerpt "Pilots should study the information provided by manufacturers and suppliers of these systems and follow the guidance provided."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Evacuate the aircraft after landing, being aware of hazards associated with a deployed parachute."^^xsd:string ;
            av:expected_result "Occupants safely exit the aircraft without injury."^^xsd:string ;
            av:source_excerpt "Once on the ground, there are hazards associated with a deployed parachute and the effect of surface winds, and the occupants should know the procedures for evacuation."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Deploying the parachute results in the loss of the airframe."^^xsd:string ] ;
    av:name "Ballistic Parachute Deployment"^^xsd:string ;
    av:source_excerpt "Pilots should brief passengers with access to any deployment mechanism regarding the conditions for a safe deployment."^^xsd:string ;
    av:source_file "33_ballistic_parachutes.txt"^^xsd:string ;
    av:source_section "Ballistic Parachutes"^^xsd:string ;
    av:trigger_condition "Catastrophic loss of controllability, actual loss of control, or pilot incapacitation"^^xsd:string .

av:proc_1_engine_failure_after a av:EmergencyProcedure ;
    av:aircraft_phase "takeoff"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Lower the nose of the airplane"^^xsd:string ;
            av:expected_result "Establish the proper glide attitude"^^xsd:string ;
            av:source_excerpt "the pilot should lower the nose of the airplane and establish the proper glide attitude."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Select a field directly ahead or slightly to the side of the takeoff path"^^xsd:string ;
            av:expected_result "Prepare for a controlled landing"^^xsd:string ;
            av:source_excerpt "the pilot should select a field directly ahead (or slightly to the side of the takeoff path)"^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Practice turns in both directions at a safe altitude"^^xsd:string ;
            av:expected_result "Gain proficiency in executing a turn back maneuver"^^xsd:string ;
            av:source_excerpt "Training for a turn back includes practicing turns in both directions at a safe altitude"^^xsd:string ;
            av:step_number 4 ;
            av:step_type "training_note"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Consider turning back toward the point of departure if conditions allow"^^xsd:string ;
            av:expected_result "Evaluate the feasibility of a turn back"^^xsd:string ;
            av:source_excerpt "the pilot might turn back, but only if certain the airplane can reach the field from its current position"^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Do not attempt a turn back unless a successful turn back will result"^^xsd:string ;
            av:expected_result "Avoid unnecessary risk during an emergency"^^xsd:string ;
            av:source_excerpt "The pilot should not attempt a turn back unless a successful turn back will result."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "caution"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Turning back at low altitudes presents an unacceptable risk for student pilots, low-time pilots, untrained pilots, and pilots without adequate proficiency."^^xsd:string ],
        [ a av:Warning ;
            av:description "If the pilot does not lower the nose sufficiently during the turn, an accelerated stall and fatal crash may occur."^^xsd:string ],
        [ a av:Warning ;
            av:description "If the airplane strikes the ground during the turn, cartwheeling could occur."^^xsd:string ] ;
    av:name "Engine Failure After Takeoff (Single-Engine)"^^xsd:string ;
    av:source_excerpt "When an engine failure occurs during the initial climb, the pilot should lower the nose of the airplane and establish the proper glide attitude."^^xsd:string ;
    av:source_file "12_engine_failure_after_takeoff_single_engine.txt"^^xsd:string ;
    av:source_section "Engine Failure After Takeoff (Single-Engine)"^^xsd:string ;
    av:trigger_condition "Engine failure occurs during the initial climb"^^xsd:string .

av:proc_2_emergency_descent a av:EmergencyProcedure ;
    av:aircraft_phase "Descent"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Initiate recovery from the emergency descent at a high enough altitude"^^xsd:string ;
            av:expected_result "Ensure a safe recovery back to level flight or a precautionary landing"^^xsd:string ;
            av:source_excerpt "The recovery from an emergency descent should be initiated at a high enough altitude to ensure a safe recovery back to level flight or a precautionary landing."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Reduce power to idle"^^xsd:string ;
            av:expected_result "Allow the propeller to act as an aerodynamic brake"^^xsd:string ;
            av:source_excerpt "Except when prohibited by the manufacturer, the power should be reduced to idle, and the propeller control (if equipped) should be placed in the low pitch (or high revolutions per minute (rpm)) position."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Extend landing gear and flaps as recommended by the manufacturer"^^xsd:string ;
            av:expected_result "Provide maximum drag for rapid descent without excessive airspeed"^^xsd:string ;
            av:source_excerpt "The landing gear and flaps should be extended as recommended by the manufacturer. This provides maximum drag so that the descent can be made as rapidly as possible, without excessive airspeed."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Ensure airspeed does not exceed never-exceed speed, maximum landing gear extended speed, or maximum flap extended speed"^^xsd:string ;
            av:expected_result "Prevent structural damage to the airplane"^^xsd:string ;
            av:source_excerpt "The pilot should not allow the airplane’s airspeed to pass the never-exceed speed (V NE), the maximum landing gear extended speed (V LE), or the maximum flap extended speed (V FE), as applicable."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Establish a bank of approximately 30 to 45°"^^xsd:string ;
            av:expected_result "Maintain positive load factors (G forces) on the airplane"^^xsd:string ;
            av:source_excerpt "When initiating the descent, a bank of approximately 30 to 45° should be established to maintain positive load factors (G forces) on the airplane."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Comply with design maneuvering speed (V A) limitations if in turbulent conditions"^^xsd:string ;
            av:expected_result "Ensure safe descent without structural stress"^^xsd:string ;
            av:source_excerpt "If the descent is conducted in turbulent conditions, the pilot also needs to comply with the design maneuvering speed (V A) limitations."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Prolonged practice of emergency descents should be avoided to prevent excessive cooling of the engine cylinders."^^xsd:string ] ;
    av:name "Emergency Descent"^^xsd:string ;
    av:source_excerpt "An emergency descent is a maneuver for descending as rapidly as possible to a lower altitude or to the ground for an emergency landing."^^xsd:string ;
    av:source_file "13_emergency_descents.txt"^^xsd:string ;
    av:source_section "Emergency Descents"^^xsd:string ;
    av:trigger_condition "Uncontrollable fire, sudden loss of cabin pressurization, or any situation demanding an immediate and rapid descent"^^xsd:string .

av:proc_3_engine_fire a av:EmergencyProcedure ;
    av:aircraft_phase "cruise"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Shut off the fuel supply to the engine"^^xsd:string ;
            av:expected_result "Fuel supply is cut off, potentially extinguishing the fire"^^xsd:string ;
            av:source_excerpt "the first step on discovering a fire should be to shut off the fuel supply to the engine by placing the mixture control in the idle cut off position and the fuel selector shutoff valve to the OFF position."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Do not shut off the electrical master switch unless necessary"^^xsd:string ;
            av:expected_result "Retain the ability to communicate and navigate"^^xsd:string ;
            av:source_excerpt "the pilot should consider that unless the fire is electrical in nature, or a crash landing is imminent, deactivating the electrical system prevents the use of panel radios."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "caution"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Consider stopping the propeller rotation"^^xsd:string ;
            av:expected_result "Stops the engine-driven oil pump from feeding the fire"^^xsd:string ;
            av:source_excerpt "the pilot should consider stopping the propeller rotation by feathering or other means."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Leave the ignition switch ON"^^xsd:string ;
            av:expected_result "Fuel in the lines is used up, preventing further fuel supply to the fire"^^xsd:string ;
            av:source_excerpt "The ignition switch should be left ON in order to use up the fuel that remains in the fuel lines and components."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "The airplane may still be on fire and susceptible to explosion."^^xsd:string ],
        [ a av:Warning ;
            av:description "The airplane is expendable and the only thing that matters is the safety of those on board."^^xsd:string ],
        [ a av:Warning ;
            av:description "Engine compartment fires that appear to have been extinguished have been known to rekindle with changes in airflow pattern and airspeed."^^xsd:string ],
        [ a av:Warning ;
            av:description "The airplane may be severely structurally damaged to the point that its ability to remain under control could be lost at any moment."^^xsd:string ] ;
    av:name "Engine Fire"^^xsd:string ;
    av:source_excerpt "By the time a pilot becomes aware of an in-flight engine compartment fire, it usually is well developed."^^xsd:string ;
    av:source_file "15_engine_fire.txt"^^xsd:string ;
    av:source_section "Engine Fire"^^xsd:string ;
    av:trigger_condition "In-flight engine compartment fire indicated by smoke or flames"^^xsd:string .

av:proc_4_electrical_fire a av:EmergencyProcedure ;
    av:aircraft_phase "in-flight"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Check circuit breakers, instruments, avionics, and lights"^^xsd:string ;
            av:expected_result "Identify the faulty circuit"^^xsd:string ;
            av:source_excerpt "the pilot should attempt to identify the faulty circuit by checking circuit breakers, instruments, avionics, and lights."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Turn the master switch back ON"^^xsd:string ;
            av:expected_result "Prepare to check for faulty circuits"^^xsd:string ;
            av:source_excerpt "Turning the master switch back ON."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Select electrical switches that were ON before the fire indication one at a time"^^xsd:string ;
            av:expected_result "Check for signs of odor, smoke, or sparks"^^xsd:string ;
            av:source_excerpt "Selecting electrical switches that were ON before the fire indication one at a time."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Turn all individual electrical switches OFF"^^xsd:string ;
            av:expected_result "Isolate the faulty circuit"^^xsd:string ;
            av:source_excerpt "Turning all individual electrical switches OFF."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Turn off the battery master switch and alternator/generator switches"^^xsd:string ;
            av:expected_result "Remove the possible source of the fire"^^xsd:string ;
            av:source_excerpt "the battery master switch and alternator/generator switches should be turned off to remove the possible source of the fire."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Turn the electrical master switch OFF"^^xsd:string ;
            av:expected_result "Attempt to isolate the faulty circuit"^^xsd:string ;
            av:source_excerpt "Turning the electrical master switch OFF."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Any materials that have been ignited may continue to burn."^^xsd:string ],
        [ a av:Warning ;
            av:description "This procedure recreates the original problem; the most prudent course of action is to land as soon as possible."^^xsd:string ] ;
    av:name "Electrical Fire"^^xsd:string ;
    av:source_excerpt "The initial indication of an electrical fire is usually the distinct odor of burning insulation."^^xsd:string ;
    av:source_file "16_electrical_fires.txt"^^xsd:string ;
    av:source_section "Electrical Fires"^^xsd:string ;
    av:trigger_condition "Detection of an electrical fire indicated by the odor of burning insulation"^^xsd:string .

av:proc_5_cabin_fire a av:EmergencyProcedure ;
    av:aircraft_phase "any"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Use oxygen masks if smoke is severe"^^xsd:string ;
            av:expected_result "Crew and passengers are protected from smoke inhalation"^^xsd:string ;
            av:source_excerpt "If the smoke is severe, the passengers and crew should use oxygen masks if available."^^xsd:string ;
            av:step_number 6 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Close cabin air vents if smoke increases"^^xsd:string ;
            av:expected_result "Prevent further feeding of the fire"^^xsd:string ;
            av:source_excerpt "If smoke increases in intensity when the cabin air vents are opened, they should be immediately closed."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Identify and shut down the faulty system"^^xsd:string ;
            av:expected_result "Source of fire is controlled"^^xsd:string ;
            av:source_excerpt "A fire or smoke in the cabin should be controlled by identifying and shutting down the faulty system."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Use the fire extinguisher if available"^^xsd:string ;
            av:expected_result "Fire is suppressed or extinguished"^^xsd:string ;
            av:source_excerpt "This should be done only after the fire extinguisher (if available) is used."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Initiate an emergency descent if smoke is intense"^^xsd:string ;
            av:expected_result "Aircraft descends to a safer altitude"^^xsd:string ;
            av:source_excerpt "It may be necessary to either depressurize at altitude, if oxygen is available for all occupants, or execute an emergency descent."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Open cabin air vents to purge smoke and fumes"^^xsd:string ;
            av:expected_result "Smoke is removed from the cabin"^^xsd:string ;
            av:source_excerpt "Then the cabin air control can be opened to purge the cabin of both smoke and fumes."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Lowering the landing gear and/or wing flaps can aggravate a cabin smoke problem."^^xsd:string ] ;
    av:name "Cabin Fire"^^xsd:string ;
    av:source_excerpt "A fire in the cabin presents the pilot with two immediate demands: attacking the fire and getting the airplane safely on the ground as quickly as possible."^^xsd:string ;
    av:source_file "17_cabin_fire.txt"^^xsd:string ;
    av:source_section "Cabin Fire"^^xsd:string ;
    av:trigger_condition "Fire or smoke detected in the cabin"^^xsd:string .

av:proc_6_total_flap_failure a av:EmergencyProcedure ;
    av:aircraft_phase "approach and landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Execute a no-flap approach and landing"^^xsd:string ;
            av:expected_result "Aircraft lands safely without flaps"^^xsd:string ;
            av:source_excerpt "A no-flap approach and landing is not particularly difficult or dangerous."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Fly in a nose-high attitude to maintain altitude"^^xsd:string ;
            av:expected_result "Altitude is maintained without losing height"^^xsd:string ;
            av:source_excerpt "The airplane should be flown in a relatively nose-high attitude to maintain altitude."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Avoid excessive speed during landing"^^xsd:string ;
            av:expected_result "Prevent tail strike and ensure safe landing"^^xsd:string ;
            av:source_excerpt "The pilot should avoid the temptation to force the airplane onto the runway at an excessively high speed."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Without flaps, the airplane tends to float considerably during roundout."^^xsd:string ],
        [ a av:Warning ;
            av:description "Approaching the runway in a relatively nose-high attitude can cause serious errors in judgment of height and distance."^^xsd:string ] ;
    av:name "Total Flap Failure"^^xsd:string ;
    av:source_excerpt "The inability to extend the wing flaps necessitates a no-flap approach and landing."^^xsd:string ;
    av:source_file "17_cabin_fire.txt"^^xsd:string ;
    av:source_section "Flight Control Malfunction/Failure"^^xsd:string ;
    av:trigger_condition "Inability to extend wing flaps"^^xsd:string .

av:proc_7_asymmetric_split_fla a av:EmergencyProcedure ;
    av:aircraft_phase "landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Counter roll with opposite aileron"^^xsd:string ;
            av:expected_result "Maintain wings-level attitude"^^xsd:string ;
            av:source_excerpt "The roll encountered in a split flap situation is countered with opposite aileron."^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Touchdown at a safe margin above flaps-up stall speed"^^xsd:string ;
            av:expected_result "Ensure safe landing"^^xsd:string ;
            av:source_excerpt "The airplane should be flown onto the runway so that the touchdown occurs at an airspeed consistent with a safe margin above flaps-up stall speed."^^xsd:string ;
            av:step_number 5 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Avoid excessive flaring during landing"^^xsd:string ;
            av:expected_result "Prevent loss of control"^^xsd:string ;
            av:source_excerpt "The pilot should not risk an asymmetric stall and subsequent loss of control by flaring excessively."^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Apply substantial opposite rudder"^^xsd:string ;
            av:expected_result "Compensate for yaw caused by additional drag"^^xsd:string ;
            av:source_excerpt "The yaw caused by the additional drag created by the extended flap requires substantial opposite rudder."^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Fly approach at higher than normal airspeed"^^xsd:string ;
            av:expected_result "Avoid asymmetric stall and maintain control"^^xsd:string ;
            av:source_excerpt "The approach to landing with a split flap condition should be flown at a higher than normal airspeed."^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:hasWarning [ a av:Warning ;
            av:description "Do not attempt to land with a crosswind from the side of the deployed flap."^^xsd:string ] ;
    av:name "Asymmetric Split Flap"^^xsd:string ;
    av:source_excerpt "The roll encountered in a split flap situation is countered with opposite aileron."^^xsd:string ;
    av:source_file "18_asymmetric_split_flap.txt"^^xsd:string ;
    av:source_section "Asymmetric (Split) Flap"^^xsd:string ;
    av:trigger_condition "One flap deploys or retracts while the other remains in position"^^xsd:string .

av:proc_8_loss_of_elevator_con a av:EmergencyProcedure ;
    av:aircraft_phase "cruise, landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Increase forward pressure to lower the nose and relax forward pressure to raise the nose"^^xsd:string ;
            av:expected_result "Control the pitch attitude effectively"^^xsd:string ;
            av:source_excerpt "Increasing forward pressure to lower the nose and relaxing forward pressure to raise the nose"^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Apply considerable nose-up trim"^^xsd:string ;
            av:expected_result "Retain pitch control"^^xsd:string ;
            av:source_excerpt "Applying considerable nose-up trim"^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Release forward pressure to flare for landing"^^xsd:string ;
            av:expected_result "Prepare for landing"^^xsd:string ;
            av:source_excerpt "Releasing forward pressure to flare for landing"^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Push the control yoke forward to attain and maintain desired attitude"^^xsd:string ;
            av:expected_result "Maintain desired pitch attitude"^^xsd:string ;
            av:source_excerpt "Pushing the control yoke forward to attain and maintain desired attitude"^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Loss of Elevator Control (Up Cable Failure)"^^xsd:string ;
    av:source_excerpt "When experiencing a loss of up-elevator control, the pilot can retain pitch control by:"^^xsd:string ;
    av:source_file "19_loss_of_elevator_control.txt"^^xsd:string ;
    av:source_section "Loss of Elevator Control"^^xsd:string ;
    av:trigger_condition "Failure of the up elevator cable"^^xsd:string .

av:proc_9_loss_of_elevator_con a av:EmergencyProcedure ;
    av:aircraft_phase "cruise, landing"^^xsd:string ;
    av:hasStep [ a av:ProcedureStep ;
            av:action "Release back pressure to lower the nose and increase back pressure to raise the nose"^^xsd:string ;
            av:expected_result "Control the pitch attitude effectively"^^xsd:string ;
            av:source_excerpt "Releasing back pressure to lower the nose and increasing back pressure to raise the nose"^^xsd:string ;
            av:step_number 3 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Apply considerable nose-down trim"^^xsd:string ;
            av:expected_result "Retain pitch control"^^xsd:string ;
            av:source_excerpt "Applying considerable nose-down trim"^^xsd:string ;
            av:step_number 1 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Increase back pressure to flare for landing"^^xsd:string ;
            av:expected_result "Prepare for landing"^^xsd:string ;
            av:source_excerpt "Increasing back pressure to flare for landing"^^xsd:string ;
            av:step_number 4 ;
            av:step_type "immediate_action"^^xsd:string ],
        [ a av:ProcedureStep ;
            av:action "Pull the control yoke aft to attain and maintain attitude"^^xsd:string ;
            av:expected_result "Maintain desired pitch attitude"^^xsd:string ;
            av:source_excerpt "Pulling the control yoke aft to attain and maintain attitude"^^xsd:string ;
            av:step_number 2 ;
            av:step_type "immediate_action"^^xsd:string ] ;
    av:name "Loss of Elevator Control (Down Cable Failure)"^^xsd:string ;
    av:source_excerpt "When experiencing a loss of down-elevator control, the pilot can retain pitch control by:"^^xsd:string ;
    av:source_file "19_loss_of_elevator_control.txt"^^xsd:string ;
    av:source_section "Loss of Elevator Control"^^xsd:string ;
    av:trigger_condition "Failure of the down elevator cable"^^xsd:string .

